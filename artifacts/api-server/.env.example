# ZOO-BOZOR API server sozlamalari. Nusxalab ".env" deb saqlang (git'ga tushmaydi).
PORT=5000

# Firebase loyiha ID (ilovadagi EXPO_PUBLIC_FIREBASE_PROJECT_ID bilan bir xil).
EXPO_PUBLIC_FIREBASE_PROJECT_ID=

# PostgreSQL ulanish satri, masalan: postgres://user:parol@localhost:5432/zoobozor
DATABASE_URL=

# Google kirish (telefon) uchun shifrlash kaliti — uzun tasodifiy satr.
SESSION_SECRET=

# Eski Clerk hisoblarini bog'lash uchun (bo'lmasa yangi foydalanuvchi kira olmaydi).
CLERK_SECRET_KEY=

# Faqat eski Clerk foydalanuvchilari bo'lmagan yangi baza uchun: off
# LEGACY_CLERK_LOOKUP=off
