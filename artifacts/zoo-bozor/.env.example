# ZOO-BOZOR mobil ilova sozlamalari.
# Ishlatish: shu faylni ".env" nomi bilan nusxalang va qiymatlarni to'ldiring.
# Qiymatlar: Firebase Console -> Project settings -> General -> Your apps -> Web app (SDK config).

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# API server domeni, protokolsiz (masalan: api.zoo-bozor.uz). Bo'sh bo'lsa, e'lonlar serverdan yuklanmaydi.
EXPO_PUBLIC_DOMAIN=
